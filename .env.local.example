# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Stripe (Developers -> API keys / Products / Webhooks in the Stripe dashboard)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Base URL of the deployed site, used for Stripe checkout redirects.
NEXT_PUBLIC_SITE_URL=
